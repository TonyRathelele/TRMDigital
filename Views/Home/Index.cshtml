<!-- About Section -->
<section id="about" class="section-padding about-section">
    <div class="container">
        <div class="row align-items-center gy-5">

            <div class="col-lg-6">
                <div class="about-visual">

                    <div class="about-main-card">
                        <div class="about-logo">
                            <i class="bi bi-code-square"></i>
                        </div>

                        <h3>Technology made simple</h3>

                        <p>
                            Practical digital solutions designed around
                            your goals.
                        </p>
                    </div>

                    <div class="experience-card">
                        <strong>100%</strong>
                        <span>Commitment to quality</span>
                    </div>

                </div>
            </div>

            <div class="col-lg-6">
                <div class="section-heading">
                    <span class="section-label">ABOUT TRM DIGITAL</span>

                    <h2>
                        We turn your ideas into
                        <span>digital experiences.</span>
                    </h2>
                </div>

                <p class="about-text">
                    TRM Digital is a technology business focused on helping
                    companies, entrepreneurs and individuals succeed through
                    dependable digital services.
                </p>

                <p class="about-text">
                    Whether you need a new website, a mobile application,
                    custom business software, secure hosting or technical
                    assistance, we provide a solution that matches your needs
                    and budget.
                </p>

                <div class="about-values">
                    <div class="value-item">
                        <div class="value-icon">
                            <i class="bi bi-lightbulb"></i>
                        </div>

                        <div>
                            <h4>Creative solutions</h4>
                            <p>Modern ideas built around real business needs.</p>
                        </div>
                    </div>

                    <div class="value-item">
                        <div class="value-icon">
                            <i class="bi bi-headset"></i>
                        </div>

                        <div>
                            <h4>Personal support</h4>
                            <p>Clear communication before and after launch.</p>
                        </div>
                    </div>
                </div>

                <a class="text-link"
                asp-controller="Home"
                asp-action="About">
                    Learn more about us
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

        </div>
    </div>
</section>

