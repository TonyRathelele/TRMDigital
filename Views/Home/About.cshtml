@{
    ViewData["Title"] = "About Us";
}
<h1>@ViewData["Title"]</h1>

<!-- About Section -->
<section id="about" class="section-padding about-section">
    <div class="container">
        <div class="row align-items-center gy-5">

            <div class="col-lg-6">
                <div class="section-heading">
                    <span class="section-label">ABOUT TRM DIGITAL</span>

                    <h2>
                        We turn your ideas into
                        <span>digital experiences.</span>
                    </h2>
                </div>

                <p class="about-text">
                    TRM Digital is a technology business focused on helping
                    companies, entrepreneurs and individuals succeed through
                    dependable digital services.
                </p>

                <p class="about-text">
                    We provide a range of technology services including website
                    development, web applications, mobile applications, custom software,
                    hosting, cloud solutions, system maintenance and IT support. Our
                    services are designed to support both new ideas and existing
                    businesses looking to improve their digital presence.
                </p>

                <p class="about-text">
                    At TRM Digital, we understand that every client has different
                    requirements. Instead of providing a one-size-fits-all solution,
                    we take the time to understand the problem, business process or
                    idea before recommending and developing the right technology
                    solution.
                </p>

                <p class="about-text">
                    We focus on building digital products that are modern, responsive,
                    user-friendly and reliable. From a simple business website to a
                    custom management system or mobile application, our goal is to
                    create technology that is useful, easy to use and capable of growing
                    with the needs of the client.
                </p>

                <p class="about-text">
                    Our work combines software development, web technologies, cloud
                    platforms and technical support to provide clients with a complete
                    technology partner rather than just a development service. We can
                    assist from the initial idea and planning stage through development,
                    deployment and ongoing maintenance.
                </p>

                <p class="about-text">
                    Whether you are starting a new business, improving an existing
                    website, developing a digital product or looking for technical
                    support, TRM Digital provides technology solutions designed around
                    your specific needs.
                </p>


            </div>

        </div>
    </div>
</section>
