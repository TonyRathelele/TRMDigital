<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TRM Digital</title>

    <meta name="description"
          content="TRM Digital provides web development, mobile apps, software solutions, hosting, maintenance and computer repair services." />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/TRMDigital.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- Navigation -->
    <header>
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top trm-navbar">
        <div class="container-fluid px-4 px-lg-5">

        <a class="navbar-brand brand-logo" asp-controller="Home" asp-action="Index">
            <img src="~/images/logo.png" alt="TRM Digital logo" class="brand-logo-img" />
        </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-lg-center" id="mainNavigation">
                <ul class="navbar-nav align-items-lg-center gap-lg-1">
                    <li class="nav-item"><a class="nav-link active" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="services">Services</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="portfolio">Projects</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="stack">Tech Stack</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about">About</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                </ul>
            </div>

            <a class="btn-office d-none d-lg-inline-flex" href="#portfolio">
                <i class="bi bi-box-seam"></i> Explore Our Office
            </a>

        </div>
    </nav>
</header>

    <!-- Main content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="trm-footer">
        <div class="container">
            <div class="row gy-4">

                <div class="col-lg-5">
                    <a class="footer-brand" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo.png" alt="TRM Digital logo" class="footer-logo-img" />
                        
                    </a>

                    <p class="footer-description">
                        Professional digital solutions for businesses and
                        individuals. We build, host, maintain and repair.
                    </p>

                    <div class="social-links">
                        <a href="#" aria-label="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#" aria-label="LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </a>

                        <a href="#" aria-label="GitHub">
                            <i class="bi bi-github"></i>
                        </a>

                        <a href="#" aria-label="WhatsApp">
                            <i class="bi bi-whatsapp"></i>
                        </a>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <h5>Company</h5>

                    <ul class="footer-links">
                        <li><a href="/#about">About</a></li>
                        <li><a href="/#services">Services</a></li>
                        <li><a href="/#portfolio">Our Work</a></li>
                        <li><a href="/#contact">Contact</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h5>Services</h5>

                    <ul class="footer-links">
                        <li><a href="/#services">Websites</a></li>
                        <li><a href="/#services">Mobile Apps</a></li>
                        <li><a href="/#services">Software</a></li>
                        <li><a href="/#services">Repairs</a></li>
                    </ul>
                </div>

                <div class="col-lg-3">
                    <h5>Contact</h5>

                    <ul class="footer-contact">
                        <li>
                            <i class="bi bi-envelope"></i>
                            info@trmdigital.co.za
                        </li>

                        <li>
                            <i class="bi bi-telephone"></i>
                            +27 73 841 6807
                        </li>

                        <li>
                            <i class="bi bi-geo-alt"></i>
                            Johannesburg, South Africa
                        </li>
                    </ul>
                </div>

            </div>

            <hr />

            <div class="footer-bottom">
                <p>
                    &copy; @DateTime.Now.Year TRM Digital. All rights reserved.
                </p>

                <p>
                    Designed and developed by TRM Digital
                </p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>